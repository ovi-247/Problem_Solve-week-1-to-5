
class Sports {

    public String getName() {
        return "Generic Sports";
    }

    public void getNumberOfTeamMembers() {
        System.out.println("Each team has n players in " + getName());
    }
}

class Soccer extends Sports {

    @Override
    public String getName() {
        return "Soccer Class";
    }

    @Override
    public void getNumberOfTeamMembers() {
        String message = "Each team has 11 players in " + getName();
        System.out.println(message);
    }
}

public class Solution {

    public static void main(String[] args) {

        Sports sport = new Sports();
        Soccer soccerGame = new Soccer();

        System.out.println(sport.getName());
        sport.getNumberOfTeamMembers();

        System.out.println(soccerGame.getName());
        soccerGame.getNumberOfTeamMembers();
    }
}
