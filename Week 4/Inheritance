
class Student extends Person 
{
    private int[] scores;

    Student(String firstName, String lastName, int id, int[] testScores) {
        super(firstName, lastName, id);
        scores = testScores;
    }

    public char calculate() {

        int total = 0;

        for (int mark : scores) {
            total += mark;
        }

        int avg = total / scores.length;

        if (avg >= 90) {
            return 'O';
        } else if (avg >= 80) {
            return 'E';
        } else if (avg >= 70) {
            return 'A';
        } else if (avg >= 55) {
            return 'P';
        } else if (avg >= 40) {
            return 'D';
        }

        return 'T';
    }
}
